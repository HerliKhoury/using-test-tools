{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "strict": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "types": [
            "vite/client",
            "vue",
            "vitest/globals"
        ],
        "sourceMap": true,
        "lib": [
            "esnext",
            "dom"
        ]
    },
    "include": [
        "src/**/*",
        "src/**/*.vue",
        "*.ts",
        "shims-vue.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}